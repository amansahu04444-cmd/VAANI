# ==============================================================================
# VAANI — Environment Variables Template
# STRICT SECURITY NOTICE: NEVER COMMIT ACTUAL SECRETS OR KEYS TO VERSION CONTROL
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Supabase Auth, PostgreSQL & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Gnani AI Platform Credentials (Server-side Only)
GNANI_API_KEY=your-gnani-api-key
GNANI_API_BASE_URL=https://api.vachana.ai

# Feature Flags
GNANI_CUSTOM_VOICE_ENABLED=false
GNANI_TTS_MODEL=timbre-v2.5
STORAGE_SIGNED_URL_EXPIRY_SECONDS=900

