# ==============================================================================
# VAANI Server — Environment Configuration Template
# STRICT SECURITY NOTICE: NEVER COMMIT ACTUAL SECRETS OR KEYS TO VERSION CONTROL
# KEEP PRIVILEGED SERVICE ROLE KEYS AND GNANI CREDENTIALS STRICTLY BACKEND-SIDE
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
# In production, set to your frontend origin(s), e.g. https://vaani.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Supabase Auth, PostgreSQL & Storage Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars

# Storage Configuration
STORAGE_SIGNED_URL_EXPIRY_SECONDS=900

# Gnani AI Platform Credentials (Server-side Only)
GNANI_API_KEY=your-gnani-api-key
GNANI_API_BASE_URL=https://api.vachana.ai

# Speech Engine & Timeout Configuration
GNANI_TTS_MODEL=timbre-v2.5
GNANI_CUSTOM_VOICE_ENABLED=false
GNANI_TTS_TIMEOUT_MS=60000
GNANI_TTS_LONG_TIMEOUT_MS=120000
